{
  "name": "human-turn-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "build": "npm run generate && tsc --noEmit && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/site.test.mjs",
    "check": "npm run build && npm run lint && npm test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.2.2"
  }
}
